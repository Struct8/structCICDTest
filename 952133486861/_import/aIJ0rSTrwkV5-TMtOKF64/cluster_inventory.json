              "app": "secure"
            }
          },
          "spec": {
            "containers": [
              {
                "command": [
                  "sh",
                  "-c",
                  "while true; do if nslookup kubernetes.default.svc.cluster.local >/dev/null 2>&1; then echo \"OK $(date -u +%FT%TZ) dns\"; else echo \"FAIL $(date -u +%FT%TZ) dns\"; fi; sleep 30; done"
