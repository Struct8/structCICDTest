      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "api",
        "namespace": "shop",
        "annotations": {
          "deployment.kubernetes.io/revision": "1"
        }
      },
      "spec": {
        "progressDeadlineSeconds": 600,
        "replicas": 1,
        "revisionHistoryLimit": 10,
        "selector": {
          "matchLabels": {
            "app": "api"
          }
        },
        "strategy": {
          "rollingUpdate": {
            "maxSurge": "25%",
            "maxUnavailable": "25%"
          },
          "type": "RollingUpdate"
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "api"
            }
          },
          "spec": {
            "containers": [
              {
                "args": [
                  "while true; do\n  if psql -tAc 'select 1' >/dev/null 2>/tmp/err; then echo \"OK $(date -u +%FT%TZ) db\"; else echo \"FAIL $(date -u +%FT%TZ) $(head -c 200 /tmp/err | tr '\\n' ' ')\"; fi\n  sleep 30\ndone\n"
                ],
                "command": [
                  "sh",
                  "-c"
                ],
                "env": [
                  {
                    "name": "PGHOST",
                    "value": "k8simp15-pg.c9g6oy6oylb0.us-west-2.rds.amazonaws.com"
                  },
                  {
                    "name": "PGUSER",
                    "value": "labadmin"
                  },
                  {
                    "name": "PGDATABASE",
                    "value": "postgres"
                  },
                  {
                    "name": "PGSSLMODE",
                    "value": "require"
                  },
                  {
                    "name": "PGCONNECT_TIMEOUT",
                    "value": "5"
                  },
                  {
                    "name": "PGPASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "key": "password",
                        "name": "db-creds"
                      }
                    }
                  }
                ],
                "image": "postgres:17-alpine",
                "imagePullPolicy": "IfNotPresent",
                "name": "api",
                "resources": {
                  "requests": {
                    "cpu": "20m",
                    "memory": "32Mi"
                  }
                },
                "terminationMessagePath": "/dev/termination-log",
                "terminationMessagePolicy": "File"
              }
            ],
            "dnsPolicy": "ClusterFirst",
            "restartPolicy": "Always",
            "schedulerName": "default-scheduler",
            "securityContext": {},
            "terminationGracePeriodSeconds": 30
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "reports",
        "namespace": "shop",
        "annotations": {
          "deployment.kubernetes.io/revision": "1"
        }
      },
      "spec": {
        "progressDeadlineSeconds": 600,
        "replicas": 1,
        "revisionHistoryLimit": 10,
        "selector": {
          "matchLabels": {
            "app": "reports"
          }
        },
        "strategy": {
          "rollingUpdate": {
            "maxSurge": "25%",
            "maxUnavailable": "25%"
          },
          "type": "RollingUpdate"
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "reports"
            }
          },
          "spec": {
            "containers": [
              {
                "args": [
                  "while true; do\n  ts=$(date -u +%FT%TZ)\n  if out=$(echo \"$ts\" | aws s3 cp - \"s3://$BUCKET/probe/$HOSTNAME.txt\" 2>&1) && role=$(aws sts get-caller-identity --query Arn --output text 2>&1); then echo \"OK $ts s3 role=${role#*:assumed-role/}\"; else echo \"FAIL $ts $(echo \"$out $role\" | head -c 200 | tr '\\n' ' ')\"; fi\n  sleep 30\ndone\n"
                ],
                "command": [
                  "bash",
                  "-c"
                ],
                "env": [
                  {
                    "name": "BUCKET",
                    "value": "k8simp15-data-d052021737"
                  },
                  {
                    "name": "AWS_REGION",
                    "value": "us-west-2"
                  }
                ],
                "image": "amazon/aws-cli:2.17.0",
                "imagePullPolicy": "IfNotPresent",
                "name": "reports",
                "resources": {
                  "requests": {
                    "cpu": "20m",
                    "memory": "64Mi"
                  }
                },
                "terminationMessagePath": "/dev/termination-log",
                "terminationMessagePolicy": "File"
              }
            ],
            "dnsPolicy": "ClusterFirst",
            "restartPolicy": "Always",
            "schedulerName": "default-scheduler",
            "securityContext": {},
            "serviceAccount": "reports",
            "serviceAccountName": "reports",
            "terminationGracePeriodSeconds": 30
          }
        }
      }
    },
